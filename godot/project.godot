; Engine configuration file.
; Sword Dodge — Godot 4.x port пиксельной игры из HTML-версии.
; Онлайн через ENet: локальная сеть или Hamachi (виртуальная сеть).

config_version=5

[application]

config/name="Sword Dodge"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"
boot_splash_show_in_list_reshape=false

[autoload]

Const="*res://autoload/const.gd"
Sprites="*res://autoload/sprites.gd"
GameSession="*res://autoload/game_session.gd"
Net="*res://autoload/net.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[file_customization]

folder_colors={
"res://autoload/": "purple",
"res://scenes/": "green",
"res://scripts/": "yellow"
}

